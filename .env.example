# Futuro: geração automática do roteiro e da narração
OPENAI_API_KEY=

# Futuro: provedor de voz opcional
ELEVENLABS_API_KEY=

# Integração local com o Hermes Agent
AI_DEMO_HERMES_COMMAND=hermes
AI_DEMO_HERMES_MODEL=
AI_DEMO_HERMES_PROVIDER=
AI_DEMO_HERMES_TIMEOUT_MS=300000

# Production GitHub launch publishing token. Use a fine-grained token
# restricted to the target repository; never commit a real value.
GITHUB_LAUNCH_TOKEN=
GITHUB_API_VERSION=2026-03-10
