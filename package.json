{
  "name": "ai-demo-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "description": "Agente que transforma aplicações web em vídeos de demonstração automaticamente.",
  "type": "module",
  "scripts": {
    "demo": "tsx src/cli.ts",
    "demo:example": "tsx src/cli.ts examples/example.demo.json",
    "plan": "tsx src/plan-cli.ts",
    "record-plan": "tsx src/record-plan-cli.ts",
    "dev:web": "npm run dev --workspace @ai-demo-agent/web",
    "worker": "npm run worker --workspace @ai-demo-agent/web",
    "build:web": "npm run build --workspace @ai-demo-agent/web",
    "lint:web": "npm run lint --workspace @ai-demo-agent/web",
    "check:web": "npm run check --workspace @ai-demo-agent/web",
    "db:generate": "npm run db:generate --workspace @ai-demo-agent/web",
    "db:validate": "npm run db:validate --workspace @ai-demo-agent/web",
    "db:migrate": "npm run db:migrate --workspace @ai-demo-agent/web",
    "db:deploy": "npm run db:deploy --workspace @ai-demo-agent/web",
    "db:studio": "npm run db:studio --workspace @ai-demo-agent/web",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@playwright/test": "^1.55.0",
    "commander": "^14.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
